<mvc:View
    controllerName="AbsenceCalendar.controller.CalenderView"
    xmlns:mvc="sap.ui.core.mvc"
    displayBlock="true"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:unified="sap.ui.unified">
    <Page
        id="page"
        title="{i18n>title}">
        <VBox
            id="Calendar_VBox"
            class="sapUiSmallMargin">
            <PlanningCalendar
                id="MIBSCalender"
                rows="{/ZM_C_AbsenceCalendar}"
                appointmentsVisualization="Filled"
                showEmptyIntervalHeaders="true"
                showWeekNumbers="true"
                viewKey="One Month"
                startDateChange=".onStartDateChange"
                appointmentHeight="HalfSize"
                height="50%">
                <toolbarContent>
                    <Title
                        id="Calendar_Title"
                        text="Abwesenheitskalender"
                        titleStyle="H2"/>
                    <SearchField
                        id="Calendar_SearchField"
                        width="30%"
                        search=".onFilterCalendar"/>
                </toolbarContent>
                <rows>
                    <PlanningCalendarRow
                        id="Calendar_PlanningCalendarRow"
                        text="Mitarbeiter"
                        title="{Fullname}"
                        appointments="{path : '_Appointments', templateShareable: false}">
                        <appointments>
                            <unified:CalendarAppointment
                                id="Calendar_CalendarAppointment"
                                startDate="{ path:'ValidFrom', type: 'sap.ui.model.odata.type.DateTimeOffset' }"
                                endDate="{ path:'ValidTo', type: 'sap.ui.model.odata.type.DateTimeOffset' }"
                                icon="{path: 'Type', formatter: '.formatter.AppointmentIcon'}"
                                title="{= ${Discription} + ' ' + ${Type}}"
                                text=""
                                type="{path: 'Type', formatter: '.formatter.AppointmentType'}"
                                tentative="false"
                            />
                        </appointments>
                    </PlanningCalendarRow>
                </rows>
            </PlanningCalendar>
        </VBox>
    </Page>
</mvc:View>
