<mvc:View
    controllerName="antragsmanagement.antrag.manage.controller.wizardDialog"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f"
    xmlns:form="sap.ui.layout.form"
    xmlns:macros="sap.fe.macros"
    xmlns:macrosTable="sap.fe.macros.table">

    <NavContainer id="wizardNavContainer">
        <pages>
            <Page id="wizardContentPage" showHeader="false">
                <content>
                    <Wizard id="createRequestWizard"
                        class="sapUiResponsivePadding--header sapUiResponsivePadding--content"
                        showNextButton="false"
                        navigationChange="handleNavigationChange"
                        renderMode="Page">

                        <!-- Step 1: Allgemeine Informationen -->
                        <WizardStep id="requestInformation"
                            title="Angtragsinformationen"
                            validated="true">

                            <form:SimpleForm
                                editable="true"
                                layout="ResponsiveGridLayout">
                                <Label text="Betreff" required="true" />
                                <Input
                                    id="inputTitle"
                                    value="{Betreff}"
                                    change=".onSelectionChange" />

                                <Label text="Beschreibung" required="true" />
                                <TextArea
                                    id="inputDescription"
                                    value="{RequestDescription}"
                                    change=".onSelectionChange"
                                    rows="6" />

                                <Label text="Kategorie" required="true" />
                                <ComboBox
                                    id="comboCategory"
                                    selectedKey="{CategoryID}"
                                    change=".onCategorySelected"
                                    items="{ path: '/Categories' }">
                                    <core:Item key="{CategoryID}" text="{Name}" />
                                </ComboBox>

                            </form:SimpleForm>

                        </WizardStep>

                        <!-- Step 2: Angebots Informationen -->
                        <WizardStep id="offerInformation"
                            validated="true"
                            title="Zusatzinformationen">

                            <HBox>
                                <VBox width="45%">

                                    <macros:Table 
                                        id="offerTable"
                                        metaPath="@com.sap.vocabularies.UI.v1.LineItem"
                                        contextPath="/_Offer"
                                        headerVisible="true"
                                        header="Angebote"
                                        readOnly="false"
                                        class="sapUiSmallMarginRight" />

                                </VBox>
                                <VBox width="10%">
                                </VBox>
                                <VBox id="idPositionTable" width="45%">


                                    <macros:Table 
                                        id="positionTable"
                                        metaPath="/_Position/@com.sap.vocabularies.UI.v1.LineItem"
                                        headerVisible="true"
                                        header="Unterpunkte"
                                        readOnly="false"
                                        class="sapUiSmallMarginLeft" />

                                </VBox>
                            </HBox>

                            <!-- <HBox justifyContent="End" class="sapUiSmallMarginTop"> -->

                            <!--     <Button id="addOfferButton" -->
                            <!--         text="Angebot hinzufügen" -->
                            <!--         type="Emphasized" -->
                            <!--         press=".onAddOffer"/> -->

                            <!--     <Button id="addPositionButton" -->
                            <!--         text="Position hinzufügen" -->
                            <!--         type="Emphasized" -->
                            <!--         press=".onAddPosition"/> -->

                            <!-- </HBox> -->
                        </WizardStep>

                        <!-- Step 3: Genehmiger wählen -->
                        <WizardStep
                            id="participantPage"
                            validated="true"
                            title="Genehmiger">

                            <macros:Table 
                                id="offerTable"
                                metaPath="@com.sap.vocabularies.UI.v1.LineItem"
                                contextPath="/_Participants"
                                headerVisible="true"
                                header="Angebote"
                                readOnly="false"
                                class="sapUiSmallMarginRight" />

                    </WizardStep>

                        <!-- Step 4: Zusammenfassung -->
                        <WizardStep
                            id="reviewPage"
                            validated="true"
                            title="Zusammenfassung">

                                <form:SimpleForm
                                    title="Antragsinformationen"
                                    editable="false"
                                    layout="ResponsiveGridLayout">
                                    <form:content>
                                        <Label text="Betreff"/>
                                        <Text id="idReviewBetreff" text="{Betreff}"/>
                                        <Label text="Beschreibung"/>
                                        <Text id="idReviewDescription" text="{RequestDescription}"/>
                                        <Label text="Kategorie"/>
                                        <Text id="idReviewCategory" text="{CategoryName}"/>
                                    </form:content>

								</form:SimpleForm>

								<form:SimpleForm
										title="Zusatzinformationen"
										editable="false"
										layout="ResponsiveGridLayout">
								</form:SimpleForm>

								<form:SimpleForm
                                    title="Genehmiger"
                                    editable="false"
                                    layout="ResponsiveGridLayout">
								</form:SimpleForm>

                        </WizardStep>
                    </Wizard>

                </content>
                <footer>
                    <OverflowToolbar>
                        <ToolbarSpacer />

                        <Button text="Zurück" 
                            visible="{wizardButton>/backButtonVisible}"
                            press="onDialogBackButton" />

                        <Button text="Weiter" 
                            type="Emphasized" 
                            enabled="{wizardButton>/nextButtonEnabled}"
                            visible="{wizardButton>/nextButtonVisible}" 
                            press="onDialogNextButton" />

                        <Button text="Abschließen" 
                            type="Emphasized"
                            visible="{wizardButton>/finishButtonVisible}" 
                            press="handleWizardSubmit" />

                        <Button text="Abbrechen" 
                            type="Transparent" 
                            press="handleWizardCancel" />

                    </OverflowToolbar>
                </footer>
            </Page>
        </pages>
    </NavContainer>
</mvc:View>
