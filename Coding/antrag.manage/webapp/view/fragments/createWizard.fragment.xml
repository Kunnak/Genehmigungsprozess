<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:f="sap.f"
	xmlns:form="sap.ui.layout.form">
	<Dialog
		id="wizardDialog"
		showHeader="false"
		verticalScrolling="false"
		contentHeight="70%"
		contentWidth="80%">
		<f:DynamicPage
			toggleHeaderOnTitleClick="false"
			class="sapUiNoContentPadding"
			showFooter="true">
			<f:title>
				<f:DynamicPageTitle>
					<f:heading>
						<Title text="Neuer Antrag"/>
					</f:heading>
				</f:DynamicPageTitle>
			</f:title>
			<f:content>
				<Wizard id="createRequest"
						class="sapUiResponsivePadding--header sapUiResponsivePadding--content"
						showNextButton="false"
						navigationChange="handleNavigationChange"
						renderMode="Page">

					<!-- Step 1: Allgemeine Informationen -->
					<WizardStep id="requestInformation"
								title="Allgemeine Informationen"
								validated="true">
						<form:SimpleForm
								editable="true"
								layout="ResponsiveGridLayout">
							<Label text="Titel" required="true"/>
							<Input 
								id="inputTitle"
								value="{wizard>/newRequest/title}"
								placeholder="Titel des Antrags"/>
							
							<Label text="Beschreibung" required="true"/>
							<TextArea 
								id="inputDescription"
								value="{wizard>/newRequest/description}"
								rows="6"
								placeholder="Detaillierte Beschreibung"/>
							
							<Label text="Priorität"/>
							<Select 
								id="selectPriority"
								selectedKey="{wizard>/newRequest/priority}">
								<core:Item key="Low" text="Niedrig"/>
								<core:Item key="Medium" text="Mittel"/>
								<core:Item key="High" text="Hoch"/>
								<core:Item key="Critical" text="Kritisch"/>
							</Select>
						</form:SimpleForm>
					</WizardStep>

					<!-- Step 2: Kategorisierung -->
					<WizardStep id="categorizationStep"
								validated="true"
								title="Kategorisierung">
						<form:SimpleForm
								editable="true"
								layout="ResponsiveGridLayout">
							<Label text="Kategorie"/>
							<Select 
								id="selectCategory"
								selectedKey="{wizard>/newRequest/category}">
								<core:Item key="Hardware" text="Hardware"/>
								<core:Item key="Software" text="Software"/>
								<core:Item key="Service" text="Service"/>
								<core:Item key="Other" text="Sonstiges"/>
							</Select>
							
							<Label text="Abteilung"/>
							<Input 
								id="inputDepartment"
								value="{wizard>/newRequest/department}"
								placeholder="Abteilung"/>
							
							<Label text="Kostenstelle"/>
							<Input 
								id="inputCostCenter"
								value="{wizard>/newRequest/costCenter}"
								placeholder="Kostenstelle"/>
						</form:SimpleForm>
					</WizardStep>

					<!-- Step 3: Zusätzliche Informationen -->
					<WizardStep id="additionalInfoStep"
								validated="true"
								title="Zusätzliche Informationen">
						<form:SimpleForm
								editable="true"
								layout="ResponsiveGridLayout">
							<Label text="Gewünschtes Lieferdatum"/>
							<DatePicker
								id="datePickerDelivery"
								value="{wizard>/newRequest/requestedDeliveryDate}"
								displayFormat="dd.MM.yyyy"/>
							
							<Label text="Budget"/>
							<Input 
								id="inputBudget"
								value="{wizard>/newRequest/budget}"
								type="Number"
								placeholder="Budget in EUR"/>
							
							<Label text="Bemerkungen"/>
							<TextArea 
								id="textAreaRemarks"
								value="{wizard>/newRequest/remarks}"
								rows="4"
								placeholder="Weitere Bemerkungen"/>
						</form:SimpleForm>
					</WizardStep>

					<!-- Step 4: Anhänge (Optional) -->
					<WizardStep id="attachmentsStep"
								validated="true"
								title="Anhänge">
						<MessageStrip 
							class="sapUiSmallMarginBottom"
							text="Hier können Sie optional Dateien zu Ihrem Antrag hinzufügen."
							showIcon="true"
							type="Information"/>
						<form:SimpleForm
								editable="true"
								layout="ResponsiveGridLayout">
							<Label text="Anhänge"/>
							<Text text="Datei-Upload wird im nächsten Schritt implementiert"/>
						</form:SimpleForm>
					</WizardStep>

					<!-- Step 5: Zusammenfassung -->
					<WizardStep
							id="reviewPage"
							validated="true"
							title="Zusammenfassung">
						<form:SimpleForm
								title="1. Allgemeine Informationen"
								editable="false"
								layout="ResponsiveGridLayout">
							<form:content>
								<Label text="Titel"/>
								<Text id="summaryTitle" text="{wizard>/newRequest/title}"/>
								<Label text="Beschreibung"/>
								<Text id="summaryDescription" text="{wizard>/newRequest/description}"/>
								<Label text="Priorität"/>
								<Text id="summaryPriority" text="{wizard>/newRequest/priority}"/>
								<Link press="editStepOne" text="Bearbeiten" />
							</form:content>
						</form:SimpleForm>

						<form:SimpleForm
								title="2. Kategorisierung"
								editable="false"
								layout="ResponsiveGridLayout">
							<form:content>
								<Label text="Kategorie"/>
								<Text id="summaryCategory" text="{wizard>/newRequest/category}"/>
								<Label text="Abteilung"/>
								<Text id="summaryDepartment" text="{wizard>/newRequest/department}"/>
								<Label text="Kostenstelle"/>
								<Text id="summaryCostCenter" text="{wizard>/newRequest/costCenter}"/>
								<Link press="editStepTwo" text="Bearbeiten" />
							</form:content>
						</form:SimpleForm>

						<form:SimpleForm
								title="3. Zusätzliche Informationen"
								editable="false"
								layout="ResponsiveGridLayout">
							<form:content>
								<Label text="Gewünschtes Lieferdatum"/>
								<Text id="summaryDeliveryDate" text="{wizard>/newRequest/requestedDeliveryDate}"/>
								<Label text="Budget"/>
								<Text id="summaryBudget" text="{wizard>/newRequest/budget}"/>
								<Label text="Bemerkungen"/>
								<Text id="summaryRemarks" text="{wizard>/newRequest/remarks}"/>
								<Link press="editStepThree" text="Bearbeiten" />
							</form:content>
						</form:SimpleForm>
					</WizardStep>
				</Wizard>
			</f:content>

			<f:footer>
				<OverflowToolbar>
					<ToolbarSpacer/>
					<Button text="Zurück" visible="{wizard>/backButtonVisible}" press="onDialogBackButton" />
					<Button text="Weiter" type="Emphasized" enabled="{wizard>/nextButtonEnabled}" visible="{wizard>/nextButtonVisible}" press="onDialogNextButton" />
					<Button text="Prüfen" type="Emphasized" visible="{wizard>/reviewButtonVisible}" press="onDialogNextButton" />
					<Button text="Abschließen" type="Emphasized" visible="{wizard>/finishButtonVisible}" press="handleWizardSubmit" />
					<Button	text="Abbrechen" type="Transparent" press="handleWizardCancel"/>
				</OverflowToolbar>
			</f:footer>
		</f:DynamicPage>
	</Dialog>
</core:FragmentDefinition>
