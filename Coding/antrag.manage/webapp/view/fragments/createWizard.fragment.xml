<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:f="sap.f"
	xmlns:form="sap.ui.layout.form">
	<Dialog
		id="wizardDialog"
		showHeader="false"
		verticalScrolling="false"
		contentHeight="80%"
		contentWidth="80%">
		<f:DynamicPage
			toggleHeaderOnTitleClick="false"
			class="sapUiNoContentPadding"
			showFooter="true">
			<f:title>
				<f:DynamicPageTitle>
					<f:heading>
						<Title text="Neuer Antrag" />
					</f:heading>
				</f:DynamicPageTitle>
			</f:title>
			<f:content>
				<Wizard id="createRequest"
					class="sapUiResponsivePadding--header sapUiResponsivePadding--content"
					showNextButton="false"
					navigationChange="handleNavigationChange"
					renderMode="Page">

					<!-- Step 1: Allgemeine Informationen -->
					<WizardStep id="requestInformation"
						title="Allgemeine Informationen"
						validated="true">
						<form:SimpleForm
							editable="true"
							layout="ResponsiveGridLayout">
							<Label text="Betreff" required="true" />
							<Input
								id="inputTitle"
                                value="{wizard>/newRequest/title}"
                                change=".onSelectionChange"
                                />

							<Label text="Beschreibung" required="true" />
							<TextArea
								id="inputDescription"
								value="{wizard>/newRequest/description}"
                                change=".onSelectionChange"
								rows="6" />

							<Label text="Kategorie" required="true" />
							<ComboBox
								id="comboCategory"
								selectedKey="{wizard>/newRequest/category_id}"
                                change=".onSelectionChange"
								items="{
                                path: '/Categories'
                                }">
								<core:Item key="{CategoryID}" text="{Name}" />
							</ComboBox>
						</form:SimpleForm>
					</WizardStep>

					<!-- Step 2: Angebots Informationen -->
					<WizardStep id="offerInformation"
						validated="true"
						title="Angebots Informationen">
						<MessageStrip class="sapUiSmallMarginBottom"
							text="Eingabe für ein oder mehrere Angebote"
							showIcon="true" />

							<HBox width="100%">
								<VBox width="50%">

								<!-- Input -->
								<form:SimpleForm
									editable="true"
									width="100%"
									layout="ResponsiveGridLayout">
									<Label class="sapUiSmallMarginBottom" text="Beschreibung"
										required="true" />
									<TextArea
										id="inputOfferDescription"
                                        change="onSelectionChange"
										value="{wizard>/currentPosition/description}"
										rows="3"/>

									<Label text="Preis" required="true" />
									<Input id="inputOfferPrice"
                                        change="onSelectionChange"
										value="{
                                            parts: ['wizard>/currentPosition/price'],
                                            type: 'Number' }" />
									<Input id="inputOfferCurrencyCode" enabled="false"
										value="{
                                            parts: ['wizard>/currentPosition/currency'] }" />
								</form:SimpleForm>
								</VBox>
								<VBox width="50%">

								<Table id="positionTable"
									items="{wizard>/currentOffer/positions}"
                                    headerText="Positionen"
									class="sapUiSmallMarginTop">
									<columns>
										<Column>
											<Text text="Beschreibung" />
										</Column>
										<Column width="10em">
											<Text text="Preis" />
										</Column>
										<Column width="5em" />
									</columns>
									<items>
										<ColumnListItem>
											<cells>
												<Text text="{wizard>description}" />
												<Text
													text="{
                                                         parts: [
                                                             {path: 'wizard>price'},
                                                             {path: 'wizard>currency'}
                                                         ],
                                                         type: 'sap.ui.model.type.Currency',
                                                         formatOptions: {showMeasure: true}
                                                     }" />
												<Button icon="sap-icon://delete" type="Transparent"
													press="onDeletePosition" />
											</cells>
										</ColumnListItem>
									</items>
								</Table>
								</VBox>
							</HBox>

							<HBox justifyContent="End" class="sapUiSmallMarginTop">
                                <Button id="addPositionButton"
                                    text="Position hinzufügen"
                                    type="Emphasized"
                                    press="onAddPosition" />
                                <Button text="Angebot übertragen"
                                    type="Emphasized"
                                    press="onAddOffer" />
							</HBox>

							<!-- Tabelle -->
							<Table id="offersTable"
								items="{wizard>/newRequest/offers}"
                                headerText="Angebote"
								class="sapUiSmallMarginTop">
								<columns>
									<Column width="5em">
										<Text text="Favorit" />
									</Column>
									<Column>
										<Text text="Beschreibung" />
									</Column>
									<Column>
										<Text text="Preis" />
									</Column>
									<Column width="8em">
										<Text text="Positionen" />
									</Column>
									<Column width="5em" />
								</columns>
								<items>
									<ColumnListItem>
										<cells>
											<RadioButton
												groupName="favoriteOffer"
												selected="{wizard>isFavorite}"
												select="onSelectFavorite" />
											<Input id=""
												value="{wizard>description}" 
												placeholder="Beschreibung eingeben..." />
											<Text
												text="{
                                             parts: [
                                                 {path: 'wizard>price'},
                                                 {path: 'wizard>currency'}
                                             ],
                                             type: 'sap.ui.model.type.Currency',
                                             formatOptions: {showMeasure: true}
                                         }" />
											<Button 
												text="{= ${wizard>positions}.length + ' Pos.'}" 
												type="Emphasized"
												press="onShowPositions" />
											<Button icon="sap-icon://delete" type="Transparent"
												press="onDeleteOffer" />
										</cells>
									</ColumnListItem>
								</items>
							</Table>
					</WizardStep>

					<!-- Step 3: Zusammenfassung -->
					<WizardStep
						id="reviewPage"
						validated="true"
						title="Zusammenfassung">
						<form:SimpleForm
							title="1. Allgemeine Informationen"
							editable="false"
							layout="ResponsiveGridLayout">
							<form:content>
								<Label text="Titel" />
								<Text id="summaryTitle" text="{wizard>/newRequest/title}" />
								<Label text="Beschreibung" />
								<Text id="summaryDescription"
									text="{wizard>/newRequest/description}" />
								<Label text="Kategorie" />
								<Text id="summaryCategory" text="{wizard>/newRequest/CategoryName}" />
								<Link press="editStepOne" text="Bearbeiten" />
							</form:content>
						</form:SimpleForm>

						<form:SimpleForm
							title="2. Angebots Informationen"
							editable="false"
							layout="ResponsiveGridLayout">
							<form:content>
								<Label text="Gewünschtes Lieferdatum" />
								<Text id="summaryDeliveryDate"
									text="{wizard>/newRequest/requestedDeliveryDate}" />
								<Label text="Budget" />
								<Text id="summaryBudget" text="{wizard>/newRequest/budget}" />
								<Label text="Bemerkungen" />
								<Text id="summaryRemarks" text="{wizard>/newRequest/remarks}" />
								<Link press="editStepTwo" text="Bearbeiten" />
							</form:content>
						</form:SimpleForm>
					</WizardStep>
				</Wizard>
			</f:content>

			<f:footer>
				<OverflowToolbar>
					<ToolbarSpacer />
					<Button text="Zurück" visible="{wizard>/backButtonVisible}"
						press="onDialogBackButton" />
					<Button text="Weiter" type="Emphasized" enabled="{wizard>/nextButtonEnabled}"
						visible="{wizard>/nextButtonVisible}" press="onDialogNextButton" />
					<Button text="Prüfen" type="Emphasized" visible="{wizard>/reviewButtonVisible}"
						press="onDialogNextButton" />
					<Button text="Abschließen" type="Emphasized"
						visible="{wizard>/finishButtonVisible}" press="handleWizardSubmit" />
					<Button text="Abbrechen" type="Transparent" press="handleWizardCancel" />
				</OverflowToolbar>
			</f:footer>
		</f:DynamicPage>
	</Dialog>
</core:FragmentDefinition>
