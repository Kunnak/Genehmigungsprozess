<core:FragmentDefinition
         xmlns="sap.m"
         xmlns:core="sap.ui.core"
         xmlns:form="sap.ui.layout.form">
         <Dialog
             title="Neuen Antrag erstellen"
             contentWidth="60%"
             contentHeight="70%"
             resizable="true"
             draggable="true">
             <content>
                 <Wizard id="createRequestWizard"
                     complete=".onWizardComplete"
                     finishButtonText="Antrag erstellen">

                     <WizardStep id="step1" title="Basis Informationen" validated="true">
                         <form:SimpleForm editable="true" layout="ResponsiveGridLayout">
                             <form:content>
                                 <Label text="Antragstitel" required="true"/>
                                 <Input id="inputTitle" placeholder="Titel eingeben"
   required="true" liveChange=".onInputChange"/>

                                 <Label text="Beschreibung"/>
                                 <TextArea id="inputDescription" rows="4"/>

                                 <Label text="Kategorie" required="true"/>
                                 <Select id="selectCategory" required="true"
   change=".onInputChange">
                                     <items>
                                         <core:Item key="1" text="Kategorie 1"/>
                                         <core:Item key="2" text="Kategorie 2"/>
                                     </items>
                                 </Select>
                             </form:content>
                         </form:SimpleForm>
                     </WizardStep>

                     <WizardStep id="step2" title="Details">
                         <form:SimpleForm editable="true" layout="ResponsiveGridLayout">
                             <form:content>
                                 <Label text="Datum"/>
                                 <DatePicker id="inputDate"/>

                                 <Label text="Betrag"/>
                                 <Input id="inputAmount" type="Number"/>
                             </form:content>
                         </form:SimpleForm>
                     </WizardStep>

                     <WizardStep id="step3" title="Zusammenfassung">
                         <VBox class="sapUiSmallMargin">
                             <Text text="Bitte prüfen Sie Ihre Angaben:"/>
                             <form:SimpleForm>
                                 <form:content>
                                     <Label text="Titel:"/>
                                     <Text id="summaryTitle"/>
                                     <Label text="Kategorie:"/>
                                     <Text id="summaryCategory"/>
                                 </form:content>
                             </form:SimpleForm>
                         </VBox>
                     </WizardStep>
                 </Wizard>
             </content>
             <beginButton>
                 <Button text="Abbrechen" press=".onCancelWizard"/>
             </beginButton>
         </Dialog>
     </core:FragmentDefinition>
